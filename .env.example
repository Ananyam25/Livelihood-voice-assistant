# ============================================================
# .env.example – Copy this to .env and fill in your API key
# ============================================================

# Gemini / Gemma 4 API key from https://aistudio.google.com/app/apikey
# Leave blank to run in MOCK mode (still works great for demos!)
GEMINI_API_KEY=

# Model name (default: gemma-3-27b-it, change to gemma-4 when available)
GEMMA_MODEL=gemma-3-27b-it

# Server port
PORT=8000
